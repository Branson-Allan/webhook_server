# Copy this file to ".env" (same folder as app.py) and fill in your values.
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# The .env file is git-ignored. Never commit real secrets.

# Credentials your CRM uses at the token URL (POST /auth/token)
# These MUST match the collectionVariables in CRM_Webhook.postman_collection.json
# and the defaults in config.py.
CLIENT_ID=crm-client
# Generate a strong one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# and update it in BOTH .env and the Postman collection.
CLIENT_SECRET=change-me-please

# Optional (defaults shown)
# TOKEN_TTL=3600          # access token lifetime in seconds
# HOST=127.0.0.1          # use 0.0.0.0 to accept connections from other machines
# PORT=8000
# DB_PATH=tickets.db
# MAX_BODY_BYTES=1000000
