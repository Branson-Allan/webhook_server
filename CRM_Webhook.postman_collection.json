{
  "info": {
    "name": "CRM Webhook",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "client_id",
      "value": "crm"
    },
    {
      "key": "client_secret",
      "value": "branson1234"
    },
    {
      "key": "access_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Get access token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('has access_token', () => pm.expect(j.access_token).to.be.a('string'));",
              "pm.collectionVariables.set('access_token', j.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_id\": \"{{client_id}}\",\n  \"client_secret\": \"{{client_secret}}\"\n}"
        },
        "url": "{{base_url}}/auth/token"
      }
    },
    {
      "name": "2. Send ticket (201 new / 200 update)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 or 200', () => pm.expect([200, 201]).to.include(pm.response.code));",
              "pm.test('success body', () => pm.expect(pm.response.json().status).to.eql('success'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_name\": \"John Doe\",\n  \"customer_email\": \"johndoe@example.com\",\n  \"customer_phone\": \"12345678\",\n  \"customer_type\": \"grages\",\n  \"customer_rating\": \"4.5\",\n  \"company\": \"ABC\",\n  \"ticket_id\": \"12334\",\n  \"location\": \"General Mathenge\",\n  \"age\": \"age in hrs\",\n  \"status\": \"Closed\",\n  \"source\": \"email\",\n  \"category\": \"general inquiry\",\n  \"disposition\": \"job inquiry\",\n  \"sub_disposition\": \"internship\",\n  \"comments\": \"This is an example\",\n  \"date_created\": \"2025-08-14 09:35:00\",\n  \"ticket_closure_date\": \"2025-08-15 14:20:00\",\n  \"created_by\": \"Jane Doe\",\n  \"assigned_to\": \"John Dalton\",\n  \"asset_name\": \"KBY105R\",\n  \"additional_variables\": [\n    {\"Response Type\": \"Open\"}\n  ]\n}"
        },
        "url": "{{base_url}}/webhook/tickets"
      }
    },
    {
      "name": "2b. Send ticket with extra random keys (stored in extra_fields)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 or 200', () => pm.expect([200, 201]).to.include(pm.response.code));",
              "pm.test('extras captured', () => pm.expect(pm.response.json().extra_fields_stored).to.include('Custom Field'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_name\": \"John Doe\",\n  \"customer_email\": \"johndoe@example.com\",\n  \"customer_phone\": \"12345678\",\n  \"customer_type\": \"grages\",\n  \"customer_rating\": \"4.5\",\n  \"company\": \"ABC\",\n  \"ticket_id\": \"12335\",\n  \"location\": \"General Mathenge\",\n  \"age\": \"age in hrs\",\n  \"status\": \"Closed\",\n  \"source\": \"email\",\n  \"category\": \"general inquiry\",\n  \"disposition\": \"job inquiry\",\n  \"sub_disposition\": \"internship\",\n  \"comments\": \"This is an example\",\n  \"date_created\": \"2025-08-14 09:35:00\",\n  \"ticket_closure_date\": \"2025-08-15 14:20:00\",\n  \"created_by\": \"Jane Doe\",\n  \"assigned_to\": \"John Dalton\",\n  \"asset_name\": \"KBY105R\",\n  \"additional_variables\": [\n    {\n      \"Response Type\": \"Open\"\n    }\n  ],\n  \"vip\": true,\n  \"sla_hours\": 24,\n  \"Custom Field\": \"anything you like\",\n  \"nested\": {\n    \"a\": [\n      1,\n      2\n    ]\n  }\n}"
        },
        "url": "{{base_url}}/webhook/tickets"
      }
    },
    {
      "name": "3. No token (expect 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"ticket_id\": \"1\"}"
        },
        "url": "{{base_url}}/webhook/tickets"
      }
    },
    {
      "name": "4. Missing ticket_id (expect 422)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"customer_name\": \"No Ticket\", \"date_created\": \"not-a-date\"}"
        },
        "url": "{{base_url}}/webhook/tickets"
      }
    },
    {
      "name": "5. Malformed JSON (expect 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ this is not json"
        },
        "url": "{{base_url}}/webhook/tickets"
      }
    }
  ]
}